# Session Minutes Portable does not require API keys, passwords, tokens,
# cloud endpoints, or any other runtime secrets.
#
# The application processes DOCX files locally. Do not place case data,
# credentials, signing certificates, or private keys in an .env file.
#
# Developers may temporarily set SESSION_MINUTES_UI_DIAGNOSTIC=1 while
# diagnosing the WinForms layout. It is not needed in normal use.
SESSION_MINUTES_UI_DIAGNOSTIC=0
